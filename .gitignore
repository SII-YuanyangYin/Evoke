# Local model weights & training output (large files, kept out of git)
#   Anchored at the repo root on purpose: otherwise it would also ignore
#   evoke/third_party/pi3/models/ (vendored model code)
/models/
output/
wandb/

# Runtime artifacts written by the inference launchers and the training scripts.
#   logs/ is the launcher log root (logs/infer_<name>/shard_N.log); *.log above only covers the
#   files, not whatever else lands in that tree.
logs/
output_*/
runs/
nohup.out
core.[0-9]*

# Tool metadata
.claude/

# Local H200 UI development copy.
/ui-h200/

# Local working conventions (CLAUDE.md and friends): local only, never committed
CLAUDE.md
claude.md

tests/

# Runtime env dump (written by the deepspeed launcher; contains cluster network / credential fragments)
.deepspeed_env

.efc_*

# Local notes and investigation records, not part of the release.
docs/
